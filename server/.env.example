# Matches docker-compose.yml at the repo root
DATABASE_URL="postgresql://btc:btc_dev_password@localhost:5432/btc_tracker?schema=public"

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
JWT_EXPIRES_IN=7d

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Used only by `npm run db:seed` to create/update the single user.
# Password must be at least 12 characters.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please

# --- Prices ---
# Optional CoinGecko demo API key (sent as x-cg-demo-api-key). Works without one.
COINGECKO_API_KEY=
# How often to fetch BTC/USD + USD/TZS (node-cron syntax). Also runs once at startup.
PRICE_REFRESH_CRON=*/15 * * * *
# Keep the USD/TZS rate in memory this long before refetching (it moves slowly).
FX_CACHE_HOURS=6
# Prices older than this are flagged "stale": true in the API.
PRICE_STALE_MINUTES=60
# Run the scheduled price job. Defaults to true (false when NODE_ENV=test; must be false in tests).
ENABLE_PRICE_JOB=true