# Matches docker-compose.yml at the repo root
DATABASE_URL="postgresql://btc:btc_dev_password@localhost:5432/btc_tracker?schema=public"

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
JWT_EXPIRES_IN=7d

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Used only by `npm run db:seed` to create/update the single user.
# Password must be at least 12 characters.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please
