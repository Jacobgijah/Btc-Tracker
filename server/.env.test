# Used only by the integration tests (vitest). Committed on purpose: nothing here is secret.
# The database name MUST end in "_test" or the test runner refuses to start.
# Put machine-specific overrides (e.g. a different port) in .env.test.local (gitignored).
NODE_ENV=test
DATABASE_URL="postgresql://btc:btc_dev_password@localhost:5432/btc_tracker_test?schema=public"
JWT_SECRET="test-only-secret-not-used-anywhere-else-0123456789"
JWT_EXPIRES_IN=1h
PORT=4001
CLIENT_ORIGIN=http://localhost:5173
ENABLE_PRICE_JOB=false
